---
// Daily mentions as a smoothed area chart, drawn at build time. No chart library needed.
// The view shows 15 days (release ± 1 week); earlier or later tracked days sit off to the sides and scroll in.
// The curve is a stretched SVG (non-scaling strokes); labels are HTML placed by percentage so text never distorts.
import { formatDate, releaseTimeline, RELEASE_WINDOW_DAYS } from '../lib/score';

interface Props { daily: number[]; start: string; end: string; releaseDate: string | null }
const { daily, start, end, releaseDate } = Astro.props;

const t = releaseTimeline(daily, start, end, releaseDate);
const { values, days } = t;
const span = Math.max(days - 1, 1);
const VIEW = 2 * RELEASE_WINDOW_DAYS; // day-intervals visible at once

// y axis: round the peak up to a step of 25 (or 5 for small films), five steps
const peakValue = Math.max(...values.map((v) => v ?? 0), 1);
const step = peakValue > 50 ? Math.ceil(peakValue / 5 / 25) * 25 : Math.ceil(peakValue / 5 / 5) * 5;
const yMax = step * 5;
const yTicks = Array.from({ length: 6 }, (_, i) => i * step);
const y = (v: number) => 100 * (1 - v / yMax); // 0..100, top to bottom
const pct = (i: number) => `${(100 * i) / span}%`;

// Monotone cubic interpolation: smooth, never dips below zero between points
function monotonePath(pts: [number, number][]) {
  const n = pts.length;
  if (n < 2) return '';
  const d: number[] = [], m: number[] = [];
  for (let i = 0; i < n - 1; i++) d.push((pts[i + 1][1] - pts[i][1]) / (pts[i + 1][0] - pts[i][0]));
  m[0] = d[0]; m[n - 1] = d[n - 2];
  for (let i = 1; i < n - 1; i++) m[i] = d[i - 1] * d[i] <= 0 ? 0 : (d[i - 1] + d[i]) / 2;
  for (let i = 0; i < n - 1; i++) {
    if (d[i] === 0) { m[i] = 0; m[i + 1] = 0; continue; }
    const a = m[i] / d[i], b = m[i + 1] / d[i], s = a * a + b * b;
    if (s > 9) { const k = 3 / Math.sqrt(s); m[i] = k * a * d[i]; m[i + 1] = k * b * d[i]; }
  }
  let p = `M${pts[0][0]},${pts[0][1]}`;
  for (let i = 0; i < n - 1; i++) {
    const h = (pts[i + 1][0] - pts[i][0]) / 3;
    p += ` C${pts[i][0] + h},${pts[i][1] + h * m[i]} ${pts[i + 1][0] - h},${pts[i + 1][1] - h * m[i + 1]} ${pts[i + 1][0]},${pts[i + 1][1]}`;
  }
  return p;
}
const first = values.findIndex((v) => v !== null);
const last = days - 1 - [...values].reverse().findIndex((v) => v !== null);
const pts = values.slice(first, last + 1).map((v, j) => [first + j, y(v ?? 0)] as [number, number]);
const line = pts.length > 1 ? monotonePath(pts) : '';

const peak = values.indexOf(peakValue);
const labelLeft = peak - t.winStart > VIEW * 0.7 || peak === days - 1;
// a date under every other day, counted from the release so the release day always gets one
const anchor = t.release ?? t.winStart;
const xTicks = Array.from({ length: days }, (_, i) => i).filter((i) => (i - anchor) % 2 === 0);
const windowEmpty = values.slice(t.winStart, t.winEnd + 1).every((v) => v === null);
const more = [first < t.winStart && 'earlier', last > t.winEnd && 'later'].filter(Boolean).join(' and ');
const dateAt = (i: number) => formatDate(t.dateAt(i));
---
<figure class="mchart"
  aria-label={`Daily mentions from ${dateAt(first)} to ${dateAt(last)}, peaking at ${peakValue} on ${dateAt(peak)}`}>
  <div class="yaxis" aria-hidden="true">
    {yTicks.map((v) => <span style={`top:${y(v)}%`}>{v}</span>)}
  </div>
  <div class="scroll" tabindex="0" data-start={t.winStart} data-span={span}>
    <div class="plot" style={`--k:${span / VIEW}`}>
      <div class="area">
        <svg viewBox={`0 0 ${span} 100`} preserveAspectRatio="none" aria-hidden="true">
          <defs>
            <linearGradient id="mfill" x1="0" x2="0" y1="0" y2="1">
              <stop offset="0" stop-color="var(--bar)" stop-opacity=".35" />
              <stop offset="1" stop-color="var(--bar)" stop-opacity="0" />
            </linearGradient>
          </defs>
          {yTicks.map((v) => <line x1="0" x2={span} y1={y(v)} y2={y(v)} stroke="var(--line)" stroke-width="1" vector-effect="non-scaling-stroke" />)}
          {t.release !== null && <line x1={t.release} x2={t.release} y1="0" y2="100" stroke="var(--faint)" stroke-width="1" stroke-dasharray="4 4" vector-effect="non-scaling-stroke" />}
          {line && <path d={`${line} L${last},100 L${first},100 Z`} fill="url(#mfill)" />}
          {line && <path d={line} fill="none" stroke="var(--bar)" stroke-width="2.4" stroke-linejoin="round" vector-effect="non-scaling-stroke" />}
        </svg>
        {peak >= 0 && values[peak] !== null && (
          <>
            <span class="dot" style={`left:${pct(peak)};top:${y(peakValue)}%`}></span>
            <span class:list={['peak', { left: labelLeft }]} style={`left:${pct(peak)};top:${y(peakValue)}%`}>{peakValue} on {dateAt(peak)}</span>
          </>
        )}
        {windowEmpty && <span class="nodata" style={`left:${pct(t.winStart + RELEASE_WINDOW_DAYS)}`}>No posts tracked around release</span>}
      </div>
      <div class="xaxis" aria-hidden="true">
        {xTicks.map((i) => <span class:list={{ rel: i === t.release, sparse: (i - anchor) % 4 !== 0 }} style={`left:${pct(i)}`}>{dateAt(i)}{i === t.release && ' · Release'}</span>)}
      </div>
    </div>
  </div>
  {more && <figcaption>Showing the week either side of release. Scroll for {more} days.</figcaption>}
</figure>
<script>
  // open each timeline on its release window
  for (const el of document.querySelectorAll<HTMLElement>('.mchart .scroll')) {
    const plot = el.firstElementChild as HTMLElement;
    const inner = plot.clientWidth - 2 * 22; // .plot padding-inline
    el.scrollLeft = (Number(el.dataset.start) / Number(el.dataset.span)) * inner;
  }
</script>
<style>
  .mchart { position: relative; margin: 0; padding-left: 38px; }
  .yaxis { position: absolute; left: 0; top: 12px; width: 30px; height: 208px; }
  .yaxis span { position: absolute; right: 0; transform: translateY(-50%); font: 11px var(--font-mono); color: var(--faint); }
  .scroll { overflow-x: auto; overscroll-behavior-x: contain; scrollbar-width: thin; }
  .scroll:focus-visible { outline: 2px solid var(--bar); outline-offset: 2px; }
  /* 100% of the scroll box shows VIEW day-intervals; --k scales that to the whole calendar */
  .plot { box-sizing: border-box; width: calc((100% - 44px) * var(--k) + 44px); padding: 12px 22px 0; }
  .area { position: relative; height: 208px; }
  .area svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .dot { position: absolute; width: 10px; height: 10px; border-radius: 50%; background: var(--gold); box-shadow: 0 0 0 2.5px var(--surface); transform: translate(-50%, -50%); }
  .peak { position: absolute; transform: translate(12px, -50%); white-space: nowrap; font: 600 12px var(--font-body); color: var(--fg); }
  .peak.left { transform: translate(calc(-100% - 12px), -50%); }
  .nodata { position: absolute; top: 45%; transform: translateX(-50%); font: 13px var(--font-body); color: var(--faint); white-space: nowrap; }
  .xaxis { position: relative; height: 30px; }
  .xaxis span { position: absolute; top: 10px; transform: translateX(-50%); white-space: nowrap; font: 11px var(--font-mono); color: var(--faint); }
  .xaxis span.rel { color: var(--fg); font-weight: 600; }
  @media (max-width: 640px) { .xaxis span.sparse { display: none; } }
  figcaption { margin-top: 6px; font: 12px var(--font-body); color: var(--faint); }
</style>
