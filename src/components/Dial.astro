---
// The score dial: a 288° gauge with ticks every 5 points.
import Waves from './Waves.astro';
import { tierFor } from '../lib/score';
interface Props { score: number; size?: number }
const { score, size = 200 } = Astro.props;

const r = 44;
const c = 2 * Math.PI * r;
const sweep = 0.8;
const ticks = Array.from({ length: 21 }, (_, i) => {
  const a = ((126 + i * (288 / 20)) * Math.PI) / 180;
  const r1 = 49, r2 = i % 5 === 0 ? 46 : 47.5;
  return { x1: 50 + r1 * Math.cos(a), y1: 50 + r1 * Math.sin(a), x2: 50 + r2 * Math.cos(a), y2: 50 + r2 * Math.sin(a) };
});
---
<div class="dial" style={`--size:${size}px`}>
  <svg viewBox="0 0 100 100" role="img" aria-label={`Whistle Score ${score} percent`}>
    {ticks.map((t) => <line {...t} stroke="var(--faint)" stroke-width=".8" />)}
    <circle cx="50" cy="50" r={r} fill="none" stroke="var(--surface-2)" stroke-width="6" stroke-linecap="round"
      stroke-dasharray={`${c * sweep} ${c}`} transform="rotate(126 50 50)" />
    <circle class="fill" cx="50" cy="50" r={r} fill="none" stroke="var(--gold)" stroke-width="6" stroke-linecap="round"
      stroke-dasharray={`${(c * sweep * score) / 100} ${c}`} transform="rotate(126 50 50)" />
  </svg>
  <div class="center">
    <div>
      <div class="score num">{score}<sup>%</sup></div>
      {size >= 140 && <div class="lbl"><Waves waves={tierFor(score).waves} size={14} />Whistle</div>}
    </div>
  </div>
</div>
<style>
  /* the gold arc fills up once on load */
  .fill { animation: dial-in 1.4s cubic-bezier(.2,.8,.2,1) both .2s; }
  @keyframes dial-in { from { stroke-dasharray: 0 400; } }
  @media (prefers-reduced-motion: reduce) { .fill { animation: none; } }
</style>
