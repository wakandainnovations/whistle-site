---
// Small mentions curve for lists. Drawn to its own scale; it shows shape, not absolute size.
// null values are untracked days: the slot keeps its place on the x axis but nothing is drawn there.
interface Props { values: (number | null)[]; width?: number; height?: number; mark?: number | null }
const { values, width = 120, height = 32, mark = null } = Astro.props;
const max = Math.max(...values.map((v) => v ?? 0), 1);
const step = width / Math.max(values.length - 1, 1);
const first = values.findIndex((v) => v !== null);
const last = values.length - 1 - [...values].reverse().findIndex((v) => v !== null);
const pts = first < 0 ? [] : values.slice(first, last + 1).map((v, j) =>
  `${((first + j) * step).toFixed(1)},${(height - 2 - ((v ?? 0) / max) * (height - 4)).toFixed(1)}`);
const line = pts.length ? `M${pts.join(' L')}` : '';
const x0 = (first * step).toFixed(1), x1 = (last * step).toFixed(1);
---
{line && (
  <svg class="spark" viewBox={`0 0 ${width} ${height}`} width={width} height={height} aria-hidden="true">
    {mark !== null && <line x1={mark * step} x2={mark * step} y1="0" y2={height} stroke="var(--faint)" stroke-width="1" stroke-dasharray="2 2" />}
    <path d={`${line} L${x1},${height} L${x0},${height} Z`} fill="var(--bar)" opacity=".18" />
    <path d={line} fill="none" stroke="var(--bar)" stroke-width="1.6" stroke-linejoin="round" />
  </svg>
)}
<style>.spark { display: block; max-width: 100%; height: auto; }</style>
