---
// /creators: the badge builder (pick a film, copy the code) and what creators get.
// /creators?film=gd-naidu#badge opens with that film picked.
import Layout from '../layouts/Layout.astro';
import { getFilms } from '../lib/films';
import { whistleScore, tierFor, scoreLabel } from '../lib/score';

const scored = (await getFilms())
  .filter((f) => f.data.report)
  .map((f) => ({ id: f.id, title: f.data.title, language: f.data.language, score: whistleScore(f.data.report!.sentiment), featured: f.data.featured }))
  .sort((a, b) => a.title.localeCompare(b.title));
const first = scored.find((f) => f.featured) ?? scored[0];
const site = Astro.site!.href.replace(/\/$/, '');
const embedFor = (f: typeof first) =>
  `<a href="${site}/films/${f.id}">\n  <img src="${site}/badge/${f.id}.svg"\n       alt="${scoreLabel(f.score)}, ${tierFor(f.score).name}" width="220" height="64">\n</a>`;
---
<Layout title="For creators" description="Put the Whistle in your film reviews: a badge for thumbnails, posts and end cards.">
  <main>
    <section class="wrap page-head">
      <span class="eyebrow">For creators</span>
      <h1>Put the Whistle <em>in your review</em></h1>
      <p>Show what the crowd posted beside your own verdict and the IMDb rating. One badge, one link back to the full breakdown.</p>
      <nav class="subnav" aria-label="On this page">
        <a href="#badge">Get a badge</a><a href="#use">Where to use it</a><a href="#partner">Partner with us</a>
      </nav>
    </section>

    <section class="section" id="badge">
      <div class="wrap creators">
        <div class="builder">
          <label class="select big"><span>Film</span>
            <select id="film">
              {scored.map((f) => <option value={f.id} selected={f.id === first.id} data-embed={embedFor(f)} data-alt={`${scoreLabel(f.score)}, ${tierFor(f.score).name}`}>{f.title} · {f.language} · {scoreLabel(f.score)}</option>)}
            </select>
          </label>
          <div class="preview">
            <img id="badge-img" src={`/badge/${first.id}.svg`} alt={`${scoreLabel(first.score)}, ${tierFor(first.score).name}`} width="220" height="64" />
            <span class="ext">Your IMDb rating here</span>
          </div>
          <pre class="code" id="embed-code">{embedFor(first)}</pre>
          <div class="copy-row">
            <button class="btn gold" type="button" data-copy-from="#embed-code" data-done="#copied">Copy badge code</button>
            <a class="btn" id="badge-dl" href={`/badge/${first.id}.svg`} download>Download SVG</a>
            <span class="copied" id="copied" hidden>Copied</span>
          </div>
        </div>
        <div>
          <div class="section-head" style="margin-bottom:0">
            <span class="eyebrow">The badge</span>
            <h2>Pick a film, copy, paste</h2>
            <p>The badge shows the Whistle, the band and links to the film's page so your audience can check the numbers.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="use">
      <div class="wrap">
        <div class="section-head"><span class="eyebrow">Where to use it</span><h2>Anywhere you review</h2></div>
        <div class="uses">
          <div class="use"><span class="num idx">01</span><h3>Thumbnails</h3><p>Drop the SVG on your video thumbnail beside your own rating.</p></div>
          <div class="use"><span class="num idx">02</span><h3>Posts and threads</h3><p>Paste the code into a blog or newsletter. It links back to the breakdown.</p></div>
          <div class="use"><span class="num idx">03</span><h3>End cards</h3><p>Close a review with "the crowd gave it a {scoreLabel(first.score)}".</p></div>
        </div>
      </div>
    </section>

    <section class="section" id="partner">
      <div class="wrap">
        <div class="partner ticket">
          <div>
            <span class="eyebrow">Partner with us</span>
            <h2>Early partners get new films first</h2>
            <p>Reviewers and film pages who partner with Whistle get scores before they go public, plus the full report for the films they cover.</p>
          </div>
          <ul class="list-plain">
            <li>Early access to new Whistles</li>
            <li>The full Framehouse report for films you cover</li>
            <li>Your channel listed on the film's page</li>
          </ul>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .section:first-of-type { padding-top: 40px; }
  .builder { padding: 28px; border-radius: var(--radius); border: 1px solid var(--line); background: var(--surface); display: flex; flex-direction: column; gap: 18px; min-width: 0; }
  .select.big { flex-direction: column; align-items: stretch; gap: 6px; }
  .select.big select { width: 100%; border-radius: 12px; padding: 12px 14px; font-size: 15px; }
  .preview { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .copy-row { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .uses { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .use { padding: 24px; border-radius: var(--radius); background: var(--surface); border: 1px solid var(--line); display: flex; flex-direction: column; gap: 8px; transition: transform .35s cubic-bezier(.3,1.5,.5,1), border-color .2s; }
  .use:hover { transform: translateY(-5px) rotate(-.8deg); border-color: var(--gold); }
  .use .idx { font-family: var(--font-mono); font-size: 12px; color: var(--gold-text); }
  .use p { color: var(--muted); font-size: 15px; }
  .partner { --stub: 50%; display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 32px; padding: 36px 40px; align-items: center; }
  .partner h2 { font-family: var(--font-display); font-weight: 800; font-size: clamp(30px, 4vw, 44px); text-transform: uppercase; line-height: 1; margin: 12px 0; }
  .partner p { color: var(--muted); }
  @media (max-width: 760px) { .uses, .partner { grid-template-columns: 1fr; } .partner { padding: 28px; } }
</style>

<script>
  const select = document.getElementById('film') as HTMLSelectElement;
  const img = document.getElementById('badge-img') as HTMLImageElement;
  const dl = document.getElementById('badge-dl') as HTMLAnchorElement;
  const code = document.getElementById('embed-code')!;
  function show() {
    const opt = select.selectedOptions[0];
    img.src = `/badge/${select.value}.svg`;
    img.alt = opt.dataset.alt ?? '';
    dl.href = img.src;
    code.textContent = opt.dataset.embed ?? '';
  }
  const want = new URLSearchParams(location.search).get('film');
  if (want && [...select.options].some((o) => o.value === want)) select.value = want;
  select.addEventListener('change', show);
  show();
</script>
