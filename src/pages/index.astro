---
import type { CollectionEntry } from 'astro:content';
import { getFilms } from '../lib/films';
import Layout from '../layouts/Layout.astro';
import Poster from '../components/Poster.astro';
import Ticker from '../components/Ticker.astro';
import Waves from '../components/Waves.astro';
import TierChip from '../components/TierChip.astro';
import WatchChips from '../components/WatchChips.astro';
import Sparkline from '../components/Sparkline.astro';
import { SITE, LANGUAGES } from '../site.config';
import { TIERS, whistleScore, tierFor, scoreLabel, compact } from '../lib/score';
import { plain } from '../lib/plain';
import { nowShowing, runLabel, mostTalked, talkOf, inRace, scoreSolid } from '../lib/now';

type Film = CollectionEntry<'films'>;
const all = await getFilms();
const scoreOf = (f: Film) => (f.data.report ? whistleScore(f.data.report.sentiment) : -1);
const byScore = [...all].filter((f) => f.data.report).sort((a, b) => scoreOf(b) - scoreOf(a));
// Scores worth promoting: more than 100 sentiment-scored posts behind the % (src/lib/now.ts)
const topScores = byScore.filter(scoreSolid);
const byNewest = [...all].sort((a, b) => (b.data.releaseDate ?? '').localeCompare(a.data.releaseDate ?? ''));

// Hero carousel: films in theatres now or releasing soon, led by the one with the most traction and the
// most positive talk (see src/lib/now.ts). Real AuraService films come before sample films.
const fan = nowShowing(all, 6);
const featured = fan[0];
const glowOf = (f: Film) => f.data.backdrop ?? f.data.poster ?? '';
const glow = glowOf(featured) || byNewest.find((f) => f.data.backdrop)?.data.backdrop;
// starting spots: the front card, then right, the back of the deck, and left last
const spotFor = (i: number) => (i === 0 ? 'mid' : i === 1 ? 'right' : i === fan.length - 1 ? 'left' : 'back');

// Picks: the films the crowd liked most, filterable by where they stream
const picks = topScores.filter((f) => scoreOf(f) >= 75 && f.data.watch.length);
const platformCounts = new Map<string, number>();
picks.forEach((f) => f.data.watch.forEach((p) => platformCounts.set(p, (platformCounts.get(p) ?? 0) + 1)));
const platforms = [...platformCounts.entries()].sort((a, b) => b[1] - a[1]).map(([p]) => p);

// The Whistle Race teaser: AuraService films with enough talk (hasEnoughTalk) are in the race; the top three scored ones with a poster lead
const raceFilms = all.filter(inRace);
const raceTop = topScores.filter((f) => inRace(f) && f.data.poster).slice(0, 3);

// In theatres or out within a week, most posts first (src/lib/now.ts). Real films only.
const talked = mostTalked(all, 5);
const showcase = byNewest.filter((f) => f.data.backdrop && f.data.trailer).slice(0, 4);

const tickerA = [
  ...topScores.slice(0, 10).map((f) => ({ strong: f.data.title, text: scoreLabel(scoreOf(f)) })),
  { strong: `${all.length}`, text: 'films on Whistle' },
];
const tickerB = [
  ...TIERS.map((t) => ({ strong: t.name, text: `${t.min}–${t.max}` })),
  { strong: '', text: 'Measured from posts, not votes' },
];

const bandCount = (t: (typeof TIERS)[number]) => byScore.filter((f) => scoreOf(f) >= t.min && scoreOf(f) <= t.max).length;

// One line on why a film is a pick: its strongest topic and how loud it was
const whyLine = (f: Film) => {
  const r = f.data.report!;
  const topic = r.audience.topics.find(([n]) => !['General', 'General discussion', 'Official promo'].includes(n))?.[0];
  return `${compact(r.sentiment.positive)} positive posts${topic ? ` · buzz led by ${plain(topic).replace(/^The /, '').toLowerCase()}` : ''}`;
};

---
<Layout>
  <main>
    <section class="hero">
      {glow && <div class="hero-glow" style={`background-image:url('${glow}')`} aria-hidden="true"></div>}
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <span class="eyebrow">{SITE.tagline}</span>
          <h1>Find the films the crowd <em>loved</em></h1>
          <p class="lede">Whistle reads public posts from the month before a film's release to the month after, scores the buzz, and tells you where to watch the ones worth your night.</p>
          <form class="search" id="search-form" role="search" action="/films">
            <label for="q" class="sr-only">Search films</label>
            <input id="q" name="q" type="search" placeholder="Search a film, actor or language" autocomplete="off" />
            <button class="btn gold" type="submit">Search</button>
          </form>
        </div>

        <div class="fan" id="fan" role="region" aria-roledescription="carousel" aria-label="Featured films">
          <div class="fan-dots" role="group" aria-label="Choose a featured film">
            {fan.map((film, i) => (
              <button type="button" class:list={['fan-dot', { on: i === 0 }]} data-go={i} aria-label={`Show ${film.data.title}`} aria-pressed={i === 0 ? 'true' : 'false'}><i></i></button>
            ))}
          </div>
          {fan.map((film, i) => {
            const d = film.data;
            const s = scoreOf(film);
            return (
              <a class:list={['fan-card', spotFor(i)]} href={`/films/${film.id}`} data-i={i} data-glow={glowOf(film)} aria-label={`${d.title}, ${scoreLabel(s)}`} tabindex={i === 0 ? 0 : -1}>
                <Poster language={d.language} year={d.year} title={d.title} poster={d.poster} score={s} label={d.title} eager={i < 3} />
              </a>
            );
          })}
          <div class="float-wrap">
            {fan.map((film, i) => {
              const d = film.data;
              const r = d.report!;
              const s = scoreOf(film);
              return (
                <a class:list={['ticket', 'float', { on: i === 0 }]} href={`/films/${film.id}`} data-i={i} data-waves={tierFor(s).waves} aria-hidden={i === 0 ? undefined : 'true'} tabindex={i === 0 ? 0 : -1}>
                  <span class="float-score">
                    <span class="float-num num">{s}<small>%</small></span>
                    <span class="float-unit"><Waves waves={tierFor(s).waves} size={16} />Whistle</span>
                  </span>
                  <span class="float-text">
                    <TierChip score={s} size="sm" />
                    <span class="float-title">{d.title}</span>
                    <span class="float-sub num">{compact(r.sentiment.positive + r.sentiment.neutral + r.sentiment.negative)} posts · {d.language} · {runLabel(film) || d.year}{d.sample && <span class="float-sample">Sample</span>}</span>
                    <span class="meter" aria-hidden="true"><i style={`--w:${s}%`}></i></span>
                  </span>
                </a>
              );
            })}
          </div>
        </div>
      </div>

      <div class="tickers">
        <Ticker items={tickerA} label="Top scores on Whistle" tilt={-2} speed={60} />
        <Ticker items={tickerB} label="The four whistles" variant="ink" reverse tilt={1.4} speed={36} />
      </div>
    </section>

    {raceTop.length > 0 && (
      <section class="wrap race-teaser">
        <a class="rt-card" href="/race">
          <span class="rt-live"><i></i>Updated hourly</span>
          <span class="rt-copy"><b>The Whistle Race</b><span>{raceFilms.length} films we track, pinned to their release dates and ranked as the crowd posts.</span></span>
          <span class="rt-top">
            {raceTop.map((f, i) => (
              <span class="rt-f"><span class="rt-rank num">{i + 1}</span><img src={f.data.poster!.replace('/w500/', '/w185/')} alt="" loading="lazy" /><span class="rt-t">{f.data.title}</span><span class="rt-s num">{scoreOf(f)}%</span></span>
            ))}
          </span>
          <span class="rt-go">Watch the race →</span>
        </a>
      </section>
    )}

    <!-- Picks -->
    <section class="section picks-section" id="picks">
      <div class="wrap">
        <div class="row-head">
          <div class="section-head" style="margin-bottom:0">
            <span class="eyebrow">Tonight's picks</span>
            <h2>Loved by the crowd, ready to stream</h2>
          </div>
          <div class="pill-row" role="group" aria-label="Filter picks by platform">
            <button class="pill" type="button" data-pick="all" aria-pressed="true">All</button>
            {platforms.map((p) => <button class="pill" type="button" data-pick={p} aria-pressed="false">{p}</button>)}
          </div>
        </div>
        <div class="carousel" id="picks-carousel">
        <button class="car-btn prev" type="button" aria-label="Previous picks" disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg></button>
        <button class="car-btn next" type="button" aria-label="More picks"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg></button>
        <div class="pick-row" id="pick-row">
          {picks.map((film) => {
            const d = film.data;
            const s = scoreOf(film);
            return (
              <article class="pick" data-watch={d.watch.join('|')}>
                <a class="pick-link" href={`/films/${film.id}`}>
                  <span class="pick-poster">
                    <img src={d.backdrop ?? d.poster!} alt="" loading="lazy" />
                    <span class="pick-score num">{s}<small>%</small><em>Whistle</em></span>
                  </span>
                  <span class="pick-body">
                    <span class="pick-band"><Waves waves={tierFor(s).waves} size={14} />{tierFor(s).name}</span>
                    <span class="pick-title">{d.title}</span>
                    <span class="pick-meta">{d.language} · {d.year}{d.runtime && ` · ${d.runtime}`}</span>
                    <span class="pick-why">{whyLine(film)}</span>
                  </span>
                </a>
                <WatchChips watch={d.watch} tmdbId={d.tmdbId} title={d.title} label />
              </article>
            );
          })}
        </div>
        </div>
        <div class="car-foot">
          <div class="car-dots" id="pick-dots" role="tablist" aria-label="Pick pages"></div>
          <span class="car-count num" id="pick-count"></span>
        </div>
        <p class="empty-note" id="pick-empty" hidden>No picks on that platform yet.</p>
      </div>
    </section>

    <!-- Most talked about + trailers -->
    <section class="section buzz-section">
      <div class="wrap buzz-grid">
        <div>
          <div class="section-head" style="margin-bottom:22px">
            <span class="eyebrow">Loudest right now</span>
            <h2>Most talked about</h2>
          </div>
          <ol class="board">
            {talked.map((film, i) => {
              const d = film.data;
              const s = scoreOf(film);
              const when = runLabel(film);
              return (
                <li>
                  <a href={`/films/${film.id}`}>
                    <span class="rank num">{i + 1}</span>
                    <img src={d.poster!} alt="" loading="lazy" />
                    <span class="board-main">
                      <span class="board-title">{d.title}</span>
                      <span class="board-meta num">{compact(talkOf(film))} posts · {d.language}{when && ` · ${when}`}</span>
                    </span>
                    <span class="board-spark">{d.report && <Sparkline values={d.report.mentions.daily} />}</span>
                    {s >= 0
                      ? <span class="board-score num" data-waves={tierFor(s).waves}>{s}%<small>Whistle</small></span>
                      : <span class="board-score num">Soon<small>Whistle</small></span>}
                  </a>
                </li>
              );
            })}
          </ol>
        </div>
        <div>
          <div class="section-head" style="margin-bottom:22px">
            <span class="eyebrow">New on Whistle</span>
            <h2>Trailers</h2>
          </div>
          <div class="reel">
            {showcase.map((film) => {
              const d = film.data;
              const s = scoreOf(film);
              return (
                <a class="still" href={`/films/${film.id}#trailer`}>
                  <img src={d.backdrop!} alt="" loading="lazy" />
                  <span class="still-shade"></span>
                  <span class="still-chip">{s >= 0 ? <><b class="num">{s}%</b> Whistle</> : 'Score coming soon'}</span>
                  <span class="still-body">
                    <span class="still-title">{d.title}</span>
                    <span class="still-play"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="var(--gold)" /><path d="M9.5 7.5v9l7-4.5z" fill="var(--gold-ink)" /></svg>Watch {d.trailer!.kind}</span>
                  </span>
                </a>
              );
            })}
          </div>
        </div>
      </div>
    </section>

    <!-- Explore -->
    <section class="section explore">
      <div class="wrap">
        <div class="row-head">
          <div class="section-head" style="margin-bottom:0">
            <span class="eyebrow">Browse by whistle</span>
            <h2>How loud was the hall?</h2>
          </div>
          <a class="btn" href="/how#bands">How the bands work →</a>
        </div>
        <div class="whistles">
          {TIERS.map((t) => (
            <a class="whistle-tile" href={`/films?band=${encodeURIComponent(t.name)}`} data-waves={t.waves}>
              <Waves waves={t.waves} size={54} />
              <span class="wt-name">{t.name}</span>
              <span class="wt-meta num">{t.min}–{t.max}% · {bandCount(t)} films</span>
            </a>
          ))}
        </div>
        <div class="langs">
          {LANGUAGES.map((l) => <a class="pill" href={`/films?lang=${l}`}>{l} <span class="num">{all.filter((f) => f.data.language === l).length}</span></a>)}
          <a class="pill all" href="/films">All {all.length} films →</a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* ---------- hero ---------- */
  .hero { position: relative; overflow: hidden; padding-top: 56px; isolation: isolate; }
  .hero-glow { position: absolute; inset: -10% -10% 30% 35%; z-index: -1; transform: translateZ(0); pointer-events: none; background-size: cover; background-position: center; filter: blur(60px) saturate(1.3); opacity: .38; }
  .hero-glow::after { content: ""; position: absolute; inset: 0; background: radial-gradient(closest-side, transparent, var(--bg)); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 40px; align-items: center; }
  .hero-copy { min-width: 0; padding-bottom: 40px; }
  .hero h1 { font-family: var(--font-display); font-weight: 900; text-transform: uppercase; font-size: clamp(56px, 8vw, 112px); line-height: .86; margin-top: 16px; }
  .hero h1 em { font-style: normal; color: var(--gold-text); display: inline-block; transform: rotate(-3deg); transition: transform .3s cubic-bezier(.3,1.6,.5,1); }
  .hero h1:hover em { transform: rotate(3deg) scale(1.05); }
  .hero .lede { font-size: 18.5px; color: var(--muted); max-width: 46ch; margin-top: 22px; }

  .fan { position: relative; height: 540px; min-width: 0; touch-action: pan-y; }
  /* Cards move between four spots: mid (front), left, right, and back (hidden behind the front card).
     The two side cards are out of focus so the front film reads first. */
  .fan-card { --x: -50%; --y: 0px; --r: -2deg; --s: 1; position: absolute; top: 30px; left: 50%; width: 46%; max-width: 270px; text-decoration: none; transform: translateX(var(--x)) translateY(var(--y)) rotate(var(--r)) scale(var(--s)); transform-origin: 50% 110%; will-change: transform, filter;
    transition: transform .9s cubic-bezier(.65,0,.25,1), filter .9s ease, opacity .6s ease; }
  .fan-card :global(.poster) { box-shadow: 0 30px 60px -20px rgba(0,0,0,.7); }
  .fan-card.mid { z-index: 3; }
  .fan-card.left { --x: -108%; --y: 30px; --r: -12deg; z-index: 2; filter: blur(2.5px) brightness(.72); }
  .fan-card.right { --x: 8%; --y: 36px; --r: 10deg; z-index: 2; filter: blur(2.5px) brightness(.72); }
  .fan-card.back { --x: -50%; --y: 46px; --r: 0deg; --s: .82; z-index: 1; opacity: 0; filter: blur(4px) brightness(.6); pointer-events: none; }
  .fan-card.left:hover, .fan-card.right:hover { filter: blur(1px) brightness(.85); }
  .fan-card.mid:hover { --y: -10px; }

  /* progress dots: the lit one fills while a film is on show; the fill pauses while you hover */
  .fan-dots { position: absolute; top: 2px; left: 50%; transform: translateX(-50%); z-index: 9; display: flex; gap: 6px; }
  .fan-dot { width: 8px; height: 8px; padding: 0; border: 0; border-radius: 99px; background: color-mix(in srgb, var(--fg) 25%, transparent); cursor: pointer; overflow: hidden; transition: width .4s cubic-bezier(.3,1.3,.5,1), background .2s; position: relative; }
  .fan-dot:hover { background: color-mix(in srgb, var(--fg) 45%, transparent); }
  .fan-dot.on { width: 34px; }
  .fan-dot i { position: absolute; inset: 0; width: 0; background: var(--gold); border-radius: inherit; }
  .fan-dot.on i { animation: dot-fill var(--hold, 4s) linear forwards; }
  .fan.paused .fan-dot.on i { animation-play-state: paused; }
  @keyframes dot-fill { to { width: 100%; } }

  /* ticket: one per film, stacked in the same spot; the front film's is shown */
  .float-wrap { position: absolute; left: -8px; bottom: 14px; z-index: 8; display: grid; justify-items: start; align-items: end; animation: bob 5s ease-in-out infinite; }
  .fan.paused .float-wrap { animation-play-state: paused; }
  .float { --stub: 50%; grid-area: 1 / 1; display: flex; align-items: stretch; padding: 0; text-decoration: none; box-shadow: 0 28px 60px -24px rgba(0,0,0,.75); min-width: 300px; opacity: 0; transform: translateY(10px); pointer-events: none; transition: opacity .45s ease, transform .55s cubic-bezier(.3,1.3,.5,1); }
  .float.on { opacity: 1; transform: none; pointer-events: auto; transition-delay: .25s; }
  /* the stub takes the band's colour, so a flop reads as one at a glance */
  .float[data-waves="1"] .float-score { background: var(--surface-2); color: var(--fg); border-right-color: var(--line); }
  .float[data-waves="0"] .float-score { background: var(--neg); color: #fff; border-right-color: color-mix(in srgb, #fff 35%, transparent); }
  .float[data-waves="1"] .meter i { background: var(--muted); }
  .float[data-waves="0"] .meter i { background: var(--neg); }
  /* the score bar refills each time a film comes to the front */
  .float .meter i { animation: none; }
  .float.on .meter i { animation: meter 1.1s cubic-bezier(.2,.8,.2,1) both .45s; }
  .float-score { display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 6px; padding: 16px 20px 14px 24px; background: var(--gold); color: var(--gold-ink); border-right: 2px dashed color-mix(in srgb, var(--gold-ink) 35%, transparent); }
  .float-num { font-family: var(--font-display); font-weight: 900; font-size: 64px; line-height: .8; letter-spacing: -.02em; }
  .float-num small { font-size: .4em; vertical-align: top; margin-left: 2px; position: relative; top: .1em; }
  .float-unit { display: inline-flex; align-items: center; gap: 5px; font-family: var(--font-display); font-weight: 800; font-size: 15px; letter-spacing: .14em; text-transform: uppercase; }
  .float-text { display: flex; flex-direction: column; justify-content: center; gap: 7px; align-items: flex-start; min-width: 0; padding: 16px 26px 16px 20px; }
  .float-title { max-width: 250px; font-family: var(--font-display); font-weight: 900; font-size: 28px; text-transform: uppercase; line-height: .9; letter-spacing: .01em; }
  .float-sub { font-size: 13px; color: var(--muted); }
  .float-sample { margin-left: 8px; font-family: var(--font-mono); font-size: 10px; letter-spacing: .08em; text-transform: uppercase; padding: 1px 6px; border-radius: 4px; border: 1px dashed var(--faint); color: var(--faint); }
  .meter { display: block; width: 100%; min-width: 150px; height: 6px; border-radius: 99px; background: var(--surface-2); overflow: hidden; }
  .meter i { display: block; height: 100%; width: var(--w); border-radius: inherit; background: var(--gold); animation: meter 1.3s cubic-bezier(.2,.8,.2,1) both .3s; }
  @keyframes meter { from { width: 0; } }
  @keyframes bob { 50% { transform: translateY(-8px) rotate(-1deg); } }
  .tickers { position: relative; margin-top: 8px; padding-block: 26px 34px; display: grid; }
  .tickers > :global(*) { grid-area: 1 / 1; }
  .tickers > :global(.ticker:first-child) { z-index: 2; }

  /* ---------- race teaser ---------- */
  .race-teaser { padding-top: 34px; }
  .rt-card { display: grid; grid-template-columns: auto minmax(0, 1fr) auto auto; gap: 22px; align-items: center; padding: 16px 22px; border-radius: 18px; text-decoration: none; background: linear-gradient(90deg, color-mix(in srgb, var(--neg) 12%, var(--surface)), var(--surface) 40%); border: 1px solid var(--line); transition: transform .35s cubic-bezier(.3,1.5,.5,1), border-color .2s; }
  .rt-card:hover { transform: translateY(-4px); border-color: var(--gold); }
  .rt-live { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--neg); }
  .rt-live i { width: 10px; height: 10px; border-radius: 50%; background: var(--neg); animation: rt-ping 1.6s ease-out infinite; }
  @keyframes rt-ping { 0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--neg) 70%, transparent); } 100% { box-shadow: 0 0 0 10px transparent; } }
  .rt-copy { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .rt-copy b { font-family: var(--font-display); font-weight: 900; font-size: 28px; text-transform: uppercase; line-height: 1; }
  .rt-copy span { font-size: 13.5px; color: var(--muted); }
  .rt-top { display: flex; gap: 14px; }
  .rt-f { display: flex; align-items: center; gap: 8px; }
  .rt-rank { font-family: var(--font-display); font-weight: 900; font-size: 22px; color: var(--gold-text); }
  .rt-f img { width: 30px; height: 45px; object-fit: cover; border-radius: 5px; }
  .rt-t { font-size: 13px; font-weight: 600; max-width: 10ch; line-height: 1.15; }
  .rt-s { font-family: var(--font-display); font-weight: 900; font-size: 22px; }
  .rt-go { font-weight: 700; font-size: 14px; color: var(--gold-text); white-space: nowrap; }
  @media (max-width: 1100px) { .rt-top { display: none; } .rt-card { grid-template-columns: auto minmax(0, 1fr) auto; } }
  @media (max-width: 600px) { .rt-card { grid-template-columns: 1fr; gap: 10px; } }

  /* ---------- picks ---------- */
  .picks-section { padding-top: 40px; }
  .carousel { position: relative; }
  .pick-row { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(250px, 280px); gap: 18px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth; padding-block: 8px 14px; scrollbar-width: none; overscroll-behavior-x: contain;
    /* fade the edges that have more cards behind them */
    -webkit-mask: linear-gradient(90deg, transparent 0, #000 var(--fl, 0px), #000 calc(100% - var(--fr, 64px)), transparent 100%);
            mask: linear-gradient(90deg, transparent 0, #000 var(--fl, 0px), #000 calc(100% - var(--fr, 64px)), transparent 100%); }
  .pick-row::-webkit-scrollbar { display: none; }
  .car-btn { position: absolute; top: 34%; z-index: 2; width: 48px; height: 48px; border-radius: 50%; display: grid; place-items: center; cursor: pointer; background: var(--gold); color: var(--gold-ink); border: 0; box-shadow: 0 14px 30px -10px rgba(0,0,0,.7); transition: transform .25s cubic-bezier(.3,1.6,.5,1), opacity .2s; }
  .car-btn svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; }
  .car-btn.prev { left: -20px; }
  .car-btn.next { right: -20px; }
  .car-btn:hover:not(:disabled) { transform: scale(1.1); }
  .car-btn.prev:hover:not(:disabled) svg { transform: translateX(-2px); }
  .car-btn.next:hover:not(:disabled) svg { transform: translateX(2px); }
  .car-btn:disabled { opacity: 0; pointer-events: none; transform: scale(.6); }
  .car-foot { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-top: 8px; }
  .car-dots { display: flex; flex-wrap: wrap; gap: 6px; min-width: 0; }
  @media (max-width: 600px) { .car-dots { display: none !important; } }
  .car-dots button { width: 8px; height: 8px; padding: 0; border: 0; border-radius: 99px; background: var(--line); cursor: pointer; transition: width .3s cubic-bezier(.3,1.4,.5,1), background .2s; }
  .car-dots button[aria-selected="true"] { width: 28px; background: var(--gold); }
  .car-count { font-family: var(--font-mono); font-size: 12px; color: var(--faint); }
  .pick { scroll-snap-align: start; display: flex; flex-direction: column; gap: 12px; padding: 12px 12px 16px; border-radius: 18px; background: var(--surface); border: 1px solid var(--line); transition: transform .35s cubic-bezier(.3,1.5,.5,1), border-color .2s; }
  .pick:hover { transform: translateY(-6px); border-color: var(--gold); }
  .pick-link { display: flex; flex-direction: column; gap: 12px; text-decoration: none; }
  .pick-poster { position: relative; aspect-ratio: 16 / 10; border-radius: 12px; overflow: hidden; background: var(--surface-2); }
  .pick-poster img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 20%; transition: transform .5s ease; }
  .pick:hover .pick-poster img { transform: scale(1.06); }
  .pick-score { position: absolute; right: 10px; bottom: 10px; background: var(--gold); color: var(--gold-ink); border-radius: 10px; padding: 4px 10px 2px; font-family: var(--font-display); font-weight: 900; font-size: 34px; line-height: 1; transform: rotate(-4deg); transition: transform .3s cubic-bezier(.3,1.6,.5,1); }
  .pick-score small { font-size: .5em; }
  .pick-score em { display: block; font-style: normal; font-size: 11px; letter-spacing: .14em; text-transform: uppercase; margin-top: 1px; }
  .pick:hover .pick-score { transform: rotate(3deg) scale(1.08); }
  .pick-body { display: flex; flex-direction: column; gap: 4px; padding-inline: 4px; }
  .pick-band { display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-mono); font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: var(--gold-text); }
  .pick-title { font-family: var(--font-display); font-weight: 800; font-size: 26px; text-transform: uppercase; line-height: 1; }
  .pick-meta { font-size: 13px; color: var(--muted); }
  .pick-why { font-size: 13px; color: var(--fg); opacity: .85; }
  .pick :global(.watch) { padding-inline: 4px; margin-top: auto; }

  /* ---------- buzz board + trailers ---------- */
  .buzz-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 48px; align-items: start; }
  .buzz-grid > * { min-width: 0; }
  .board { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .board a { display: grid; grid-template-columns: 34px 46px minmax(0, 1fr) 120px 62px; gap: 14px; align-items: center; padding: 10px 14px 10px 10px; border-radius: 14px; background: var(--surface); border: 1px solid var(--line); text-decoration: none; transition: transform .3s cubic-bezier(.3,1.5,.5,1), border-color .2s; }
  .board a:hover { transform: translateX(6px); border-color: var(--gold); }
  .rank { font-family: var(--font-display); font-weight: 900; font-size: 34px; text-align: center; color: var(--gold-text); line-height: 1; }
  .board img { width: 46px; height: 64px; object-fit: cover; border-radius: 6px; }
  .board-main { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .board-title { font-weight: 700; font-size: 16px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .board-meta { font-size: 12.5px; color: var(--muted); }
  .board-score { font-family: var(--font-display); font-weight: 900; font-size: 26px; text-align: right; }
  .board-score[data-waves="3"], .board-score[data-waves="2"] { color: var(--gold-text); }
  .board-score small { display: block; font-family: var(--font-mono); font-weight: 500; font-size: 10px; letter-spacing: .1em; text-transform: uppercase; color: var(--faint); margin-top: 2px; }
  .reel { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  .still { position: relative; display: block; aspect-ratio: 4 / 3; max-width: 100%; border-radius: var(--radius); overflow: hidden; border: 1px solid var(--line); text-decoration: none; color: #fff; isolation: isolate; transition: transform .3s ease, box-shadow .3s; }
  .still:hover { transform: translateY(-4px) rotate(-.6deg); box-shadow: 0 24px 50px -24px rgba(0,0,0,.7); }
  .still img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .6s ease; z-index: -2; }
  .still:hover img { transform: scale(1.07); }
  .still-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(10,5,14,.05) 35%, rgba(10,5,14,.9)); z-index: -1; }
  .still-chip { position: absolute; top: 10px; left: 10px; padding: 5px 9px 4px; border-radius: 8px; background: rgba(10,5,14,.72); backdrop-filter: blur(6px); font-size: 12px; font-weight: 600; }
  .still-chip b { color: #F8B840; font-family: var(--font-display); font-size: 16px; margin-right: 3px; }
  .still-body { position: absolute; left: 14px; right: 14px; bottom: 12px; display: flex; flex-direction: column; gap: 4px; }
  .still-title { font-family: var(--font-display); font-weight: 900; text-transform: uppercase; font-size: 26px; line-height: .92; }
  .still-play { display: inline-flex; align-items: center; gap: 7px; font-weight: 600; font-size: 13px; text-transform: capitalize; }
  .still-play svg { width: 22px; height: 22px; transition: transform .3s cubic-bezier(.3,1.6,.5,1); }
  .still:hover .still-play svg { transform: scale(1.25); }

  /* ---------- explore ---------- */
  .whistles { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
  .whistle-tile { display: flex; flex-direction: column; gap: 10px; padding: 24px 22px 20px; border-radius: var(--radius); border: 1px solid var(--line); background: var(--surface); text-decoration: none; color: var(--gold-text); transition: transform .35s cubic-bezier(.3,1.5,.5,1), border-color .2s, background .2s; }
  .whistle-tile[data-waves="0"] { color: var(--faint); }
  .whistle-tile:nth-child(odd):hover { transform: translateY(-6px) rotate(-1.4deg); }
  .whistle-tile:nth-child(even):hover { transform: translateY(-6px) rotate(1.4deg); }
  .whistle-tile:hover { border-color: var(--gold); }
  .whistle-tile:hover :global(.w1) { animation: wave 1s ease-in-out infinite; }
  .whistle-tile:hover :global(.w2) { animation: wave 1s ease-in-out .12s infinite; }
  .whistle-tile:hover :global(.w3) { animation: wave 1s ease-in-out .24s infinite; }
  .wt-name { font-family: var(--font-display); font-weight: 900; font-size: 28px; text-transform: uppercase; line-height: 1; color: var(--fg); margin-top: 6px; }
  .wt-meta { font-family: var(--font-mono); font-size: 12.5px; color: var(--muted); }
  .langs { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 22px; }
  .langs .pill { text-decoration: none; }
  .langs .pill.all { color: var(--fg); border-color: var(--gold); }

  /* tablets and small laptops: pull the side posters in so the right one isn't cut off */
  @media (max-width: 1180px) {
    .fan-card.left { --x: -96%; --r: -10deg; }
    .fan-card.right { --x: -4%; --r: 8deg; }
    .wt-name { font-size: 24px; }
  }
  @media (max-width: 960px) {
    .hero-grid { grid-template-columns: 1fr; gap: 0; }
    .hero-copy { padding-bottom: 8px; }
    .fan { height: 470px; max-width: 520px; width: 100%; margin-inline: auto; }
    .whistles { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .buzz-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) {
    .car-btn { display: none; }
    .fan { height: 400px; }
    .fan-card { width: 44%; top: 10px; }
    .fan-card.left { --x: -100%; --y: 24px; --r: -9deg; }
    .fan-card.right { --x: -2%; --y: 28px; --r: 8deg; }
    .float-wrap { left: 0; bottom: 0; }
    .float { min-width: 0; }
    .fan-dots { top: 0; }
    .float-score { padding: 12px 14px 10px 18px; }
    .float-num { font-size: 48px; }
    .float-text { padding: 12px 18px 12px 14px; }
    .float-title { font-size: 22px; }
    .meter { min-width: 110px; }
    .board a { grid-template-columns: 28px 40px minmax(0, 1fr) 54px; }
    .board-spark { display: none; }
    .board img { width: 40px; height: 56px; }
    .reel { grid-template-columns: 1fr 1fr; gap: 10px; }
    .still-title { font-size: 20px; }
  }
  @media (prefers-reduced-motion: reduce) { .float-wrap { animation: none; } }
</style>

<script>
  // ---------- picks: filter by platform ----------
  const pickButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-pick]')];
  const picks = [...document.querySelectorAll<HTMLElement>('.pick')];
  pickButtons.forEach((b) => b.addEventListener('click', () => {
    const p = b.dataset.pick!;
    pickButtons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    let shown = 0;
    picks.forEach((card) => {
      const ok = p === 'all' || (card.dataset.watch ?? '').split('|').includes(p);
      card.hidden = !ok;
      if (ok) shown++;
    });
    document.getElementById('pick-empty')!.hidden = shown > 0;
    row.scrollTo({ left: 0 });
    requestAnimationFrame(update);
  }));

  // ---------- picks carousel: arrows, page dots, edge fades ----------
  const row = document.getElementById('pick-row')!;
  const car = document.getElementById('picks-carousel')!;
  const prev = car.querySelector<HTMLButtonElement>('.prev')!;
  const next = car.querySelector<HTMLButtonElement>('.next')!;
  const dots = document.getElementById('pick-dots')!;
  const count = document.getElementById('pick-count')!;
  const visible = () => picks.filter((p) => !p.hidden);
  const step = () => { const c = visible()[0]; return c ? c.offsetWidth + 18 : 300; };
  const perPage = () => Math.max(1, Math.floor((row.clientWidth + 18) / step()));
  const pages = () => Math.max(1, Math.ceil(visible().length / perPage()));

  function update() {
    const max = row.scrollWidth - row.clientWidth;
    const atStart = row.scrollLeft <= 4, atEnd = row.scrollLeft >= max - 4;
    prev.disabled = atStart;
    next.disabled = atEnd;
    row.style.setProperty('--fl', atStart ? '0px' : '64px');
    row.style.setProperty('--fr', atEnd ? '0px' : '64px');
    const n = pages();
    const page = atEnd ? n - 1 : Math.round(row.scrollLeft / (step() * perPage()));
    if (dots.childElementCount !== n) {
      dots.replaceChildren(...Array.from({ length: n }, (_, i) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.setAttribute('role', 'tab');
        b.setAttribute('aria-label', `Page ${i + 1}`);
        b.addEventListener('click', () => row.scrollTo({ left: i * step() * perPage() }));
        return b;
      }));
    }
    [...dots.children].forEach((b, i) => b.setAttribute('aria-selected', String(i === page)));
    dots.hidden = n < 2;
    const first = Math.min(visible().length, Math.round(row.scrollLeft / step()) + 1);
    const last = Math.min(visible().length, first + perPage() - 1);
    count.textContent = visible().length ? `${first}–${last} of ${visible().length}` : '';
  }
  prev.addEventListener('click', () => row.scrollBy({ left: -step() * perPage() }));
  next.addEventListener('click', () => row.scrollBy({ left: step() * perPage() }));
  row.addEventListener('scroll', () => requestAnimationFrame(update), { passive: true });
  addEventListener('resize', update);
  update();

  {
  // ---------- hero carousel: six featured films, the front one's ticket below ----------
  // Every few seconds the deck turns: the right card comes to the front, the front card moves left, the
  // left one goes to the back and the next film comes out on the right. The timer is the lit dot's fill
  // animation, so hovering (which pauses that animation) pauses the carousel too, and with reduced
  // motion turned on it doesn't auto-advance at all.
  const fan = document.getElementById('fan')!;
  const cards = [...fan.querySelectorAll<HTMLAnchorElement>('.fan-card')];
  const tickets = [...fan.querySelectorAll<HTMLAnchorElement>('.float')];
  const dots = [...fan.querySelectorAll<HTMLButtonElement>('.fan-dot')];
  const glowEl = document.querySelector<HTMLElement>('.hero-glow');
  const N = cards.length;
  let active = 0;

  function show(next: number) {
    active = (next + N) % N;
    cards.forEach((card, i) => {
      const k = (i - active + N) % N; // 0 front, 1 right, N-1 left, the rest at the back
      const spot = k === 0 ? 'mid' : k === 1 ? 'right' : k === N - 1 ? 'left' : 'back';
      card.classList.remove('mid', 'left', 'right', 'back');
      card.classList.add(spot);
      card.tabIndex = k === 0 ? 0 : -1;
    });
    tickets.forEach((t, i) => {
      const on = i === active;
      t.classList.toggle('on', on);
      t.tabIndex = on ? 0 : -1;
      if (on) t.removeAttribute('aria-hidden'); else t.setAttribute('aria-hidden', 'true');
    });
    dots.forEach((d, i) => {
      d.classList.toggle('on', i === active);
      d.setAttribute('aria-pressed', String(i === active));
      // restart the fill on the newly lit dot
      const bar = d.querySelector('i')!;
      bar.style.animation = 'none'; void bar.offsetWidth; bar.style.animation = '';
    });
    const g = cards[active].dataset.glow;
    if (glowEl && g) glowEl.style.backgroundImage = `url('${g}')`;
  }

  // the lit dot finishing its fill moves the deck on
  dots.forEach((d) => d.querySelector('i')!.addEventListener('animationend', () => { if (d.classList.contains('on')) show(active + 1); }));
  dots.forEach((d) => d.addEventListener('click', () => show(Number(d.dataset.go))));

  // hover or keyboard focus pauses; clicking any card or the ticket opens that film (they're links)
  const setPaused = () => fan.classList.toggle('paused', fan.matches(':hover') || fan.contains(document.activeElement));
  fan.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') fan.classList.add('paused'); });
  fan.addEventListener('pointerleave', () => setTimeout(setPaused));
  fan.addEventListener('focusin', setPaused);
  fan.addEventListener('focusout', () => setTimeout(setPaused));

  // swipe on touch screens
  let downX: number | null = null, swiped = false;
  fan.addEventListener('pointerdown', (e) => { if (e.pointerType !== 'mouse') { downX = e.clientX; swiped = false; } });
  fan.addEventListener('pointerup', (e) => {
    if (downX === null) return;
    const dx = e.clientX - downX;
    downX = null;
    if (Math.abs(dx) > 40) { swiped = true; show(active + (dx < 0 ? 1 : -1)); }
  });
  fan.addEventListener('click', (e) => { if (swiped) { e.preventDefault(); swiped = false; } }, true);

  // arrow keys when the carousel has focus
  fan.addEventListener('keydown', (e) => {
    if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
    e.preventDefault();
    show(active + (e.key === 'ArrowRight' ? 1 : -1));
    cards[active].focus();
  });
  }
</script>
