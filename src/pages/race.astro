  .race-page .lb li.lead a { background: linear-gradient(90deg, color-mix(in srgb, var(--gold) 16%, var(--surface)), var(--surface) 60%); border-color: color-mix(in srgb, var(--gold) 50%, var(--line)); }
  .race-page .lb .rk { font-family: var(--font-display); font-weight: 900; font-size: 28px; text-align: center; color: var(--muted); }
  .race-page .lb li.lead .rk { color: var(--gold-text); }
  .race-page .lb img { width: 34px; height: 48px; object-fit: cover; border-radius: 5px; }
  .race-page .lb .nm { display: flex; flex-direction: column; min-width: 0; gap: 2px; }
  .race-page .lb .nm b { font-size: 15px; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .race-page .lb .nm span { font-size: 12px; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .race-page .lb .bar { height: 12px; border-radius: 99px; background: var(--surface-2); overflow: hidden; }
  .race-page .lb .bar i { display: block; height: 100%; border-radius: inherit; background: linear-gradient(90deg, var(--bar), var(--gold)); transition: width .9s cubic-bezier(.3,1,.4,1); }
  .race-page .lb li.upcoming .bar i { background: repeating-linear-gradient(135deg, var(--bar) 0 8px, color-mix(in srgb, var(--bar) 70%, transparent) 8px 16px); }
  .race-page .lb .sc { font-family: var(--font-display); font-weight: 900; font-size: 26px; text-align: right; }
  .race-page .lb .sc small { font-size: .5em; }
  .race-page .lb .chg { font-family: var(--font-mono); font-size: 12px; text-align: right; color: var(--faint); }
  .race-page .lb .chg.up { color: var(--pos); }
  .race-page .lb .chg.down { color: var(--neg); }
  .race-page .lb li.flash a { animation: flash 1.1s ease; }
  @keyframes flash { 30% { border-color: var(--gold); box-shadow: 0 0 0 3px color-mix(in srgb, var(--gold) 30%, transparent); } }
  .race-page .movers { display: flex; flex-direction: column; gap: 12px; position: sticky; top: 90px; margin-top: 26px; }
  .race-page .mover { padding: 16px 18px; border-radius: var(--radius); background: var(--surface); border: 1px solid var(--line); display: flex; flex-direction: column; gap: 4px; }
  .race-page .mover b { font-family: var(--font-display); font-weight: 800; font-size: 22px; text-transform: uppercase; line-height: 1.05; }
  .race-page .mover span.num { font-size: 13px; color: var(--muted); }
  .race-page .mover.up { border-left: 4px solid var(--pos); }
  .race-page .mover.down { border-left: 4px solid var(--neg); }
  .race-page .mover.hot { border-left: 4px solid var(--gold); }
  .race-page .movers-note { font-size: 12px; color: var(--faint); line-height: 1.5; }
  @media (max-width: 900px) { .race-page .race-grid { grid-template-columns: 1fr; } .race-page .movers { position: static; margin-top: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); } .race-page .movers-note { grid-column: 1 / -1; } }
  @media (max-width: 600px) {
    .race-page .lb-head, .race-page .lb a { grid-template-columns: 30px 30px minmax(0, 1fr) 52px 44px; gap: 10px; }
    .race-page .lb .bar, .race-page .lb-head .h-bar { display: none; }
    .race-page .lb-head .h-chg { font-size: 0; } .race-page .lb-head .h-chg::after { content: '1h'; font-size: 11px; }
    .race-page .lb img { width: 30px; height: 44px; }
    .race-page .movers { grid-template-columns: 1fr; }
    .race-page .replay { order: 2; }
  }
</style>

<script>
  type Film = { id: string; title: string; language: string; release: string; poster: string | null; score: number | null; posts: number };
  type Tier = { name: string; min: number; max: number; waves: number };
  const { films, tiers } = (window as any).__RACE as { films: Film[]; tiers: Tier[] };

  const DAY = 864e5, HOUR = 36e5;
  const utc = (iso: string) => Date.parse(`${iso}T00:00:00Z`);
  const now = new Date();
  const today = Date.UTC(now.getFullYear(), now.getMonth(), now.getDate());
  const fmt = (t: number, o: Intl.DateTimeFormatOptions) => new Date(t).toLocaleDateString('en-US', { timeZone: 'UTC', ...o });
  const clock = (t: number) => new Date(t).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' });
  document.getElementById('today-label')!.textContent = fmt(today, { weekday: 'short', month: 'short', day: 'numeric' });

  const inWindow = films;
  const scored = (f: Film) => f.score !== null;
  const tierFor = (s: number) => tiers.find((t) => s >= t.min && s <= t.max) ?? tiers[tiers.length - 1];
  const days = (f: Film) => Math.round((utc(f.release) - today) / DAY);
  // the leaderboard only ranks films releasing within BOARD_DAYS of today (either side); the timeline keeps them all
  const BOARD_DAYS = 14;
  const onBoard = inWindow.filter((f) => Math.abs(days(f)) <= BOARD_DAYS);
  const when = (f: Film) => {
    const d = days(f);
    if (d > 1) return `Releases in ${d} days`;
    if (d === 1) return 'Releases tomorrow';
    if (d === 0) return 'Releases today';
    return `Day ${-d + 1} in theatres`;
  };

  // ---------- hourly data ----------
  // PREVIEW: simulated. Each film's change over the last hour is seeded by film and hour, so it's stable
  // within an hour. Before launch, return the real current and previous-hour scores from the feed.
  const seeded = (key: string) => {
    let h = 2166136261;
    for (const c of key) h = Math.imul(h ^ c.charCodeAt(0), 16777619);
    return () => { h = Math.imul(h ^ (h >>> 15), 2246822507); h = Math.imul(h ^ (h >>> 13), 3266489909); return ((h ^= h >>> 16) >>> 0) / 4294967296; };
  };
  type Snap = { now: number; prev: number; postsHour: number };
  function hourly(hour: number): Map<string, Snap> {
    return new Map(inWindow.filter(scored).map((f) => {
      const r = seeded(`${f.id}:${Math.round(hour / HOUR)}`);
      const change = Math.round((r() + r() - 1) * 4); // mostly small, now and then ±3–4
      const activeDays = Math.max(1, Math.min(62, -days(f) + 31));
      const postsHour = Math.round((f.posts / (activeDays * 24)) * (0.5 + r()));
      return [f.id, { now: f.score!, prev: Math.max(0, Math.min(100, f.score! - change)), postsHour }];
    }));
  }
  // the start of the current hour on the visitor's clock (works for half-hour time zones like IST)
  const hourStart = () => { const d = new Date(); d.setMinutes(0, 0, 0); return d.getTime(); };
  let hour = hourStart();
  let snap = hourly(hour);

  function stamp() {
    document.getElementById('upd-last')!.textContent = `Last update ${clock(hour)}`;
    document.getElementById('upd-next')!.textContent = `Next update ${clock(hour + HOUR)}`;
  }

  // ---------- timeline ----------
  const tl = document.getElementById('timeline')!;
  const track = document.getElementById('track')!;
  const pins = [...tl.querySelectorAll<HTMLElement>('.pin')];
  const CHIP = 56, CHIP_H = 84, LANE = 112, GAP = 10;

  // The timeline covers every release plus today. Runs of more than MAX_GAP_DAYS with no release are
  // collapsed into a fixed-width break, so one film from years ago doesn't leave a mile of empty track.
  const PX_PER_DAY = 9, PAD_DAYS = 6, MAX_GAP_DAYS = 45, BREAK_PX = 90;
  type Seg = { start: number; end: number; px: number };
  const segs: Seg[] = [];
  {
    const points = [...new Set([today, ...inWindow.map((f) => utc(f.release))])].sort((a, b) => a - b);
    let px = 0;
    for (const t of points) {
      const last = segs[segs.length - 1];
      if (last && t - last.end <= (MAX_GAP_DAYS - PAD_DAYS) * DAY) { last.end = t + PAD_DAYS * DAY; continue; }
      if (last) px += ((last.end - last.start) / DAY) * PX_PER_DAY + BREAK_PX;
      segs.push({ start: t - PAD_DAYS * DAY, end: t + PAD_DAYS * DAY, px });
    }
  }
  const lastSeg = segs[segs.length - 1];
  const totalPx = lastSeg.px + ((lastSeg.end - lastSeg.start) / DAY) * PX_PER_DAY;
  const span = (ms: number) => { const m = Math.round(ms / (30.4 * DAY)); return m >= 2 ? `${m} months` : `${Math.round(ms / (7 * DAY))} weeks`; };

  function layout() {
    // at least as wide as the screen; wider (and scrollable) when there are many releases
    const W = Math.max(tl.parentElement!.clientWidth - 32, 1100, totalPx);
    tl.style.width = `${W}px`;
    const k = W / totalPx;
    const x = (t: number) => {
      const g = segs.find((s) => t <= s.end) ?? lastSeg;
      return (g.px + ((t - g.start) / DAY) * PX_PER_DAY) * k;
    };

    // a faint tick every day, a label every Monday, the month names, and a break between far-apart runs
    track.replaceChildren();
    segs.forEach((g, gi) => {
      for (let t = g.start; t <= g.end; t += DAY) {
        const d = new Date(t);
        const tick = document.createElement('span');
        const isWeek = d.getUTCDay() === 1;
        tick.className = `tick${isWeek ? ' week' : ''}`;
        tick.style.left = `${x(t)}px`;
        if (isWeek) { const b = document.createElement('b'); b.textContent = fmt(t, { month: 'short', day: 'numeric' }); tick.append(b); }
        track.append(tick);
        if (d.getUTCDate() === 1 || t === g.start) {
          const m = document.createElement('span');
          m.className = 'month';
          const withYear = d.getUTCMonth() === 0 || t === g.start;
          m.textContent = fmt(t, withYear ? { month: 'long', year: 'numeric' } : { month: 'long' });
          m.style.left = `${x(t) + (t === g.start ? 70 : 50)}px`;
          track.append(m);
        }
      }
      const next = segs[gi + 1];
      if (next) {
        const br = document.createElement('span');
        br.className = 'gap';
        br.style.left = `${x(g.end) + (BREAK_PX * k) / 2}px`;
        br.innerHTML = '<i></i><b></b>';
        br.querySelector('b')!.textContent = `${span(next.start - g.end)} later`;
        track.append(br);
      }
    });

    // posters go in lanes, nearest the line first, alternating above and below. A poster may slide
    // right of its date (up to MAX_SHIFT, with an angled stem back to the date) before taking a new
    // lane, so a week with ten releases fans out sideways instead of stacking into one tall column.
    const MAX_SHIFT = 4 * (CHIP + GAP);
    const lanes: number[] = []; // right edge of the last poster in each lane (even = above, odd = below)
    const placed = inWindow
      .slice()
      .sort((a, b) => utc(a.release) - utc(b.release))
      .map((f) => {
        const px = x(utc(f.release));
        let lane = 0, cx = px;
        for (;; lane++) {
          cx = Math.max(px, (lanes[lane] ?? -Infinity) + GAP + CHIP / 2);
          if (cx - px <= MAX_SHIFT) break;
        }
        lanes[lane] = cx + CHIP / 2;
        return { f, px, cx, lane };
      });
    const rowsAbove = Math.max(1, ...placed.filter((p) => p.lane % 2 === 0).map((p) => p.lane / 2 + 1));
    const rowsBelow = Math.max(1, ...placed.filter((p) => p.lane % 2 === 1).map((p) => (p.lane + 1) / 2));
    const mid = 56 + rowsAbove * LANE + 10;
    tl.style.setProperty('--h', `${mid + 34 + rowsBelow * LANE}px`);
    tl.style.setProperty('--mid', `${mid}px`);
    document.getElementById('past-shade')!.style.width = `${x(today)}px`;
    document.getElementById('today-marker')!.style.left = `${x(today)}px`;

    for (const { f, px, cx, lane } of placed) {
      const pin = pins.find((p) => p.dataset.id === f.id)!;
      pin.hidden = false;
      pin.classList.toggle('upcoming', days(f) > 0);
      pin.classList.toggle('flip', cx > W - 260);
      pin.style.left = `${px}px`;
      pin.style.setProperty('--mid', `${mid}px`);
      const up = lane % 2 === 0, row = Math.floor(lane / 2);
      const top = up ? mid - 24 - CHIP_H - row * LANE : mid + 34 + row * LANE;
      const chip = pin.querySelector<HTMLElement>('.chip')!;
      chip.style.top = `${top}px`;
      chip.style.left = `${cx - px}px`;
      const edge = up ? top + CHIP_H + 10 : top; // +10 clears the score tag under the poster
      // stem from the dot on the line to the poster, angled when the poster slid sideways
      const dx = cx - px, dy = edge - mid, len = Math.hypot(dx, dy);
      const stem = pin.querySelector<HTMLElement>('.stem')!;
      stem.style.top = `${mid}px`;
      stem.style.height = `${len}px`;
      stem.style.transformOrigin = '50% 0';
      stem.style.transform = `translateX(-50%) rotate(${(Math.atan2(-dx, dy) * 180) / Math.PI}deg)`;
      pin.querySelector('[data-when]')!.textContent = when(f);
    }
    return x(today);
  }
  const todayX = layout();
  addEventListener('resize', layout);
  // open with today in the middle of the view
  const sc = document.getElementById('tl-scroll')!;
  sc.scrollLeft = Math.max(0, todayX - sc.clientWidth / 2);

  // ---------- leaderboard ----------
  const lb = document.getElementById('lb')!;
  let show = 'all';
  const ROW = 64;
  const rows = new Map<string, HTMLLIElement>();
  for (const f of onBoard) {
    const li = document.createElement('li');
    li.innerHTML = `<a href="/films/${f.id}">
      <span class="rk num"></span>
      ${f.poster ? `<img src="${f.poster}" alt="" loading="lazy" />` : '<span class="ph"></span>'}
      <span class="nm"><b></b><span></span></span>
      <span class="bar"><i></i></span>
      <span class="sc num"><b></b><small>%</small></span>
      <span class="chg num"></span></a>`;
    li.querySelector('.nm b')!.textContent = f.title;
    li.querySelector('.nm span')!.textContent = `${f.language} · ${when(f)}`;
    li.classList.toggle('upcoming', days(f) > 0);
    lb.append(li);
    rows.set(f.id, li);
  }

  const change = (id: string) => snap.get(id)!.now - snap.get(id)!.prev;
  const chgText = (d: number) => (d > 0 ? `▲ ${d}` : d < 0 ? `▼ ${-d}` : 'no change');

  // phase 'prev' draws the board as it stood an hour ago; 'now' moves it to the latest update
  let lastOrder: string[] = [];
  function render(phase: 'prev' | 'now' = 'now') {
    // films with no posts yet have no snapshot: they rank last, soonest release first
    const val = (id: string) => { const st = snap.get(id); return st ? (phase === 'prev' ? st.prev : st.now) : -1; };
    const visible = onBoard.filter((f) => show === 'all' || (show === 'released' ? days(f) <= 0 : days(f) > 0));
    const ranked = visible.slice().sort((a, b) => val(b.id) - val(a.id) || (val(a.id) < 0 ? utc(a.release) - utc(b.release) : 0) || a.title.localeCompare(b.title));
    lb.style.height = `${ranked.length * ROW}px`;
    document.getElementById('lb-empty')!.hidden = ranked.length > 0;
    rows.forEach((li, id) => {
      const on = visible.some((f) => f.id === id);
      li.style.opacity = on ? '1' : '0';
      li.style.pointerEvents = on ? '' : 'none';
    });
    ranked.forEach((f, i) => {
      const li = rows.get(f.id)!;
      const s = val(f.id);
      li.style.transform = `translateY(${i * ROW}px)`;
      li.classList.toggle('lead', i === 0);
      li.querySelector('.rk')!.textContent = String(i + 1);
      li.querySelector<HTMLElement>('.bar i')!.style.width = `${Math.max(0, s)}%`;
      li.querySelector('.sc b')!.textContent = s < 0 ? '–' : String(s);
      li.classList.toggle('unscored', s < 0);
      const d = phase === 'prev' || s < 0 ? 0 : change(f.id);
      const chg = li.querySelector('.chg')!;
      chg.textContent = s < 0 ? 'no posts yet' : phase === 'prev' ? '' : d > 0 ? `▲${d}` : d < 0 ? `▼${-d}` : '–';
      chg.className = `chg num ${d > 0 ? 'up' : d < 0 ? 'down' : ''}`;
      if (phase === 'now' && lastOrder.length && lastOrder.indexOf(f.id) > i) { li.classList.remove('flash'); void li.offsetWidth; li.classList.add('flash'); }
    });
    lastOrder = ranked.map((f) => f.id);
  }

  function renderPins() {
    for (const pin of pins) {
      const st = snap.get(pin.dataset.id!);
      if (!st) { pin.querySelector('[data-tier]')!.textContent = 'Score coming soon'; continue; }
      const tier = tierFor(st.now);
      pin.querySelector('[data-live]')!.textContent = String(st.now);
      pin.querySelector<HTMLElement>('.chip-score')!.dataset.band = String(tier.waves);
      pin.querySelector('[data-tier]')!.textContent = tier.name;
      const d = st.now - st.prev;
      const c = pin.querySelector<HTMLElement>('[data-chg]')!;
      c.textContent = `${chgText(d)} in 1h`;
      c.className = `pop-chg ${d > 0 ? 'up' : d < 0 ? 'down' : ''}`;
    }
  }

  function renderMovers() {
    const all = onBoard.filter(scored).map((f) => ({ f, st: snap.get(f.id)! }));
    const d = (x: (typeof all)[number]) => x.st.now - x.st.prev;
    const upM = all.slice().sort((a, b) => d(b) - d(a))[0];
    const downM = all.slice().sort((a, b) => d(a) - d(b))[0];
    const hot = all.slice().sort((a, b) => b.st.postsHour - a.st.postsHour)[0];
    const setM = (k: string, x: (typeof all)[number] | undefined, text: string) => {
      document.getElementById(`m-${k}`)!.textContent = x ? x.f.title : '–';
      document.getElementById(`m-${k}-d`)!.textContent = x ? text : '';
    };
    setM('up', upM, upM && d(upM) > 0 ? `▲ ${d(upM)} points · now ${upM.st.now}% (${tierFor(upM.st.now).name})` : 'Holding steady');
    setM('down', downM, downM && d(downM) < 0 ? `▼ ${-d(downM)} points · now ${downM.st.now}%` : 'Nobody slipped this hour');
    setM('hot', hot, hot ? `${hot.st.postsHour.toLocaleString('en-IN')} posts in the last hour` : '');
  }

  // Board opens as it stood an hour ago, then rolls into the latest update.
  const motion = !matchMedia('(prefers-reduced-motion: reduce)').matches;
  const replayBtn = document.getElementById('replay') as HTMLButtonElement;
  function playHour() {
    if (!motion) { render('now'); return; }
    replayBtn.disabled = true;
    render('prev');
    setTimeout(() => { render('now'); replayBtn.disabled = false; }, 900);
  }

  function refresh() {
    stamp();
    renderPins();
    renderMovers();
    playHour();
  }
  refresh();
  replayBtn.addEventListener('click', playHour);

  // Next update on the hour, then every hour after.
  const untilNext = () => hourStart() + HOUR - Date.now() + 500;
  setTimeout(function next() {
    hour = hourStart();
    snap = hourly(hour);
    refresh();
    setTimeout(next, untilNext());
  }, untilNext());

  document.querySelectorAll<HTMLButtonElement>('[data-show]').forEach((b) => b.addEventListener('click', () => {
    show = b.dataset.show!;
    document.querySelectorAll('[data-show]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    render('now');
  }));
</script>
