---
// /race: The Whistle Race. Every movie tracked in AuraService is pinned to its release date as a small
// poster with its Whistle (positive sentiment %), once it has enough talk (hasEnoughTalk in src/lib/now.ts); films with no posts yet show "Soon". Stretches of the
// timeline with no releases collapse into a labelled break. Hovering a poster shows the details. The
// leaderboard below ranks them and shows what changed in the last hourly update.
//
// Scores update once an hour. PREVIEW: each hour's change is simulated in the browser (seeded by the hour,
// so a reload within the same hour shows the same numbers). Before launch, replace `hourly()` in the
// script with the previous-hour snapshot from the Framehouse feed.
import Layout from '../layouts/Layout.astro';
import { getFilms } from '../lib/films';
import { whistleScore, TIERS } from '../lib/score';
import { inRace, MIN_COLLECTED_SHOWN, MIN_POSTS_SHOWN } from '../lib/now';

// AuraService movies with a release date and enough talk (hasEnoughTalk; upcoming ones too).
// Sample films (made-up scores) stay out of the race.
const films = (await getFilms())
  .filter(inRace)
  .map((f) => {
    const s = f.data.report?.sentiment;
    return {
      id: f.id,
      title: f.data.title,
      language: f.data.language,
      release: f.data.releaseDate!,
      poster: f.data.poster ? f.data.poster.replace('/w500/', '/w185/') : null,
      score: s ? whistleScore(s) : null,
      posts: s ? s.positive + s.neutral + s.negative : 0,
    };
  });
const tiers = TIERS.map((t) => ({ name: t.name, min: t.min, max: t.max, waves: t.waves }));
---
<Layout title="The Whistle Race" description="Every film we track, pinned to its release date with its Whistle, ranked and updated every hour.">
  <main class="race-page">
    <section class="wrap page-head race-head">
      <div class="head-row">
        <div>
          <span class="eyebrow">The Whistle Race</span>
          <h1>Who's winning <em>the crowd</em> right now</h1>
          <p>Every film we track with more than {MIN_COLLECTED_SHOWN.toLocaleString('en-US')} posts ({MIN_POSTS_SHOWN} scored posts for films we don't collect), pinned to its release date. Scores refresh every hour as new posts are counted. Films still to release show their pre-release buzz.</p>
        </div>
        <div class="today-badge">
          <span class="live-pill"><i></i>Updated hourly</span>
          <span class="today-date" id="today-label"></span>
          <span class="today-sub"><span id="upd-last"></span><br /><span id="upd-next"></span></span>
        </div>
      </div>
    </section>

    <!-- Timeline -->
    <section class="timeline-wrap" aria-label="Release timeline">
      <div class="timeline-scroll" id="tl-scroll">
        <div class="timeline" id="timeline">
          <div class="past-shade" id="past-shade" aria-hidden="true"></div>
          <div class="tl-track" id="track" aria-hidden="true"></div>
          <div class="today" id="today-marker" aria-hidden="true"><span>Today</span></div>
          {films.map((f) => (
            <a class="pin" href={`/films/${f.id}`} data-id={f.id} hidden aria-label={f.title}>
              <span class="stem" aria-hidden="true"></span>
              <span class="dot" aria-hidden="true"></span>
              <span class="chip">
                {f.poster ? <img src={f.poster} alt="" loading="lazy" width="56" height="84" /> : <span class="noposter">{f.title}</span>}
                {f.score !== null
                  ? <span class="chip-score num"><b data-live>{f.score}</b><small>%</small></span>
                  : <span class="chip-score soon">Soon</span>}
                <span class="pop" aria-hidden="true">
                  <b class="pop-title">{f.title}</b>
                  <span class="pop-when" data-when></span>
                  <span class="pop-row"><span class="pop-tier" data-tier></span><span class="pop-chg" data-chg></span></span>
                </span>
              </span>
            </a>
          ))}
        </div>
      </div>
      <p class="wrap tl-hint">← Swipe the timeline to see every release →</p>
      <div class="wrap tl-legend">
        <span><i class="lg released"></i>In theatres: Whistle from the crowd</span>
        <span><i class="lg upcoming"></i>Coming soon: pre-release buzz</span>
        <span class="lg-tip">Point at a poster for details</span>
      </div>
    </section>

    <!-- Leaderboard -->
    <section class="section board-section">
      <div class="wrap">
        <div class="row-head">
          <div class="section-head" style="margin-bottom:0">
            <span class="eyebrow">Leaderboard</span>
            <h2>The race, ranked</h2>
            <p class="board-note">Films releasing within two weeks either side of today.</p>
          </div>
          <div class="board-tools">
            <button class="replay" type="button" id="replay"><span aria-hidden="true">↻</span> Replay the last hour</button>
            <div class="pill-row" role="group" aria-label="Show">
              <button class="pill" type="button" data-show="all" aria-pressed="true">All</button>
              <button class="pill" type="button" data-show="released" aria-pressed="false">In theatres</button>
              <button class="pill" type="button" data-show="upcoming" aria-pressed="false">Coming soon</button>
            </div>
          </div>
        </div>

        <div class="race-grid">
          <div>
            <div class="lb-head" aria-hidden="true"><span>#</span><span></span><span>Film</span><span class="h-bar"></span><span class="h-sc">Whistle</span><span class="h-chg">Last hour</span></div>
            <ol class="lb" id="lb" aria-live="off"></ol>
            <p class="lb-empty" id="lb-empty" hidden>No films releasing within two weeks of today.</p>
          </div>
          <aside class="movers">
            <div class="mover up"><span class="mono">Biggest climber</span><b id="m-up">–</b><span id="m-up-d" class="num"></span></div>
            <div class="mover down"><span class="mono">Losing steam</span><b id="m-down">–</b><span id="m-down-d" class="num"></span></div>
            <div class="mover hot"><span class="mono">Loudest this hour</span><b id="m-hot">–</b><span id="m-hot-d" class="num"></span></div>
            <p class="movers-note">Changes since the previous hourly update. Preview: hourly changes are simulated until the live feed is connected.</p>
          </aside>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script is:inline define:vars={{ films, tiers }}>
  window.__RACE = { films, tiers };
</script>

<style is:global>
  .race-page .race-head { padding-bottom: 28px; }
  .race-page .head-row { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px 40px; flex-wrap: wrap; }
