  .race-page .lb-empty { margin: 0; padding: 28px 0; color: var(--muted); }
  .race-page .lb li { position: absolute; left: 0; right: 0; top: 0; height: 64px; transition: transform .9s cubic-bezier(.3,1.2,.4,1), opacity .3s; }
