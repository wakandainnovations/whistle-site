  .race-page .race-grid { display: grid; grid-template-columns: minmax(0, 1fr) 280px; gap: 24px; align-items: start; }
  .race-page .lb-head, .race-page .lb a { display: grid; grid-template-columns: 40px 34px minmax(0, 1.1fr) minmax(80px, 1.4fr) 64px 70px; gap: 14px; align-items: center; padding: 0 14px 0 8px; }
  .race-page .lb-head { font-family: var(--font-mono); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--faint); margin-bottom: 8px; }
  .race-page .lb-head span:first-child { text-align: center; }
  .race-page .lb-head .h-sc, .race-page .lb-head .h-chg { text-align: right; }
