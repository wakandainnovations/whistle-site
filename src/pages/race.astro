  @media (max-width: 1240px) { .race-page .tl-hint { display: block; } .race-page .timeline-scroll { -webkit-mask: linear-gradient(90deg, transparent, #000 24px, #000 calc(100% - 24px), transparent); mask: linear-gradient(90deg, transparent, #000 24px, #000 calc(100% - 24px), transparent); } }
  .race-page .tl-legend { display: flex; flex-wrap: wrap; gap: 8px 22px; font-size: 13px; color: var(--muted); margin-top: 6px; }
  .race-page .tl-legend span { display: inline-flex; align-items: center; gap: 8px; }
